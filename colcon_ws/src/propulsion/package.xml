<?xml version="1.0"?>
<package format="3">
  <name>propulsion</name>
  <version>0.1.0</version>
  <description>Package for moving the AUV. Designed to abstract away the mechanical implementation details of the propulsion mechanism.</description>
  <maintainer email="dev@mcgillrobotics.com">McGill Robotics</maintainer>
  <license>GPLv3</license>
  <url type="repository">https://github.com/mcgill-robotics/AUV-2025</url>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
